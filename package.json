{
  "name": "tauri-cblite-litert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --config vite.config.web.ts",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts --outDir dist-web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src packages/tauri-plugin-cblite packages/tauri-plugin-litert-api/src",
    "seed:disease-kb": "node scripts/copy-disease-profiles.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "sync:up": "podman-compose -f docker/compose.yml up -d",
    "sync:down": "podman-compose -f docker/compose.yml down -v",
    "sync:reset": "pnpm sync:down && rm -rf ~/.local/share/com.ldoguin.rag-chatbot/*.cblite2 && pnpm sync:up",
    "sync:test": "node scripts/sync-test.mjs",
    "sync:ci": "npm run sync:up && sleep 60 && npm run sync:test; npm run sync:down",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "test:e2e:build": "pnpm tauri:build && pnpm test:e2e",
    "test:e2e:dev": "cargo build --manifest-path src-tauri/Cargo.toml && pnpm test:e2e",
    "test:e2e:bundle": "bash scripts/bundle-e2e.sh",
    "test:e2e:docker": "docker build -f docker/Dockerfile.e2e -t cblite-e2e . && docker run --rm --network host -e TAURI_BINARY=/bundle/tauri-cblite-litert -v $(pwd)/dist/e2e-bundle:/bundle:ro cblite-e2e"
  },
  "dependencies": {
    "@litert-lm/core": "^0.14.0",
    "@litertjs/core": "^2.5.0",
    "@mediapipe/tasks-genai": "^0.10.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@xenova/transformers": "^2.17.2",
    "highlight.js": "^11.11.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tauri-plugin-cblite": "workspace:*",
    "tauri-plugin-litert-api": "workspace:*",
    "tauri-plugin-tts-api": "^0.1.11",
    "uuid": "^11.0.3",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/types": "^9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "webdriverio": "^9"
  }
}
