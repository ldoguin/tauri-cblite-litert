# Copy to .env and fill in real values. .env is gitignored; .env.example is not.
# The deterministic pipeline (harvest/run/report/index/search) needs none of this —
# it only reads CLI flags (--seed, --sources, --out, --manifest).
#
# These are read by OpenAILLMProvider (src/agronomy_pipeline/llm.py), used only when
# you pass `run --structurer llm`. Requires the optional 'llm' extra:
#   pip install -e ".[llm]"
# Never hardcode the key in source — it's read from the environment at runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
